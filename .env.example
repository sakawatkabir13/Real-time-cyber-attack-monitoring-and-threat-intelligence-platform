# PostgreSQL
POSTGRES_DB=vanguardmap
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://vanguard:change_me_strong_password@postgres:5432/vanguardmap
DATABASE_SSL=false

# Redis
REDIS_URL=redis://redis:6379/0

# Security
ENVIRONMENT=production
COLLECTOR_TOKEN=change_me_long_random_token_for_agent_auth
SECRET_KEY=change_me_long_random_secret_for_jwt
DASHBOARD_PASSWORD=change_me_dashboard_password
# Required for production HTTPS. For local plain-HTTP development only,
# set ENVIRONMENT=development and COOKIE_SECURE=false.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
# The bundled frontend and API are same-origin, so this should remain empty.
# Add exact origins only when hosting the frontend separately.
CORS_ORIGINS=[]
MAX_LOG_SIZE_BYTES=52428800
MAX_INGEST_BATCH_SIZE=250
MAX_WEBSOCKET_CONNECTIONS=200
EVENT_RETENTION_DAYS=30

# Threat Intelligence APIs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Public listener. For a host-level TLS proxy use 127.0.0.1 and 8080.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# ML Model
MODEL_PATH=/models/behavioral_models.joblib
ML_SERVER_WINDOW_SECONDS=60
ML_SOURCE_WINDOW_SECONDS=300
ML_WINDOW_GRACE_SECONDS=20
ML_MIN_SERVER_REQUESTS=20
ML_MIN_SOURCE_REQUESTS=5
ML_MIN_TRAINING_WINDOWS=200
ML_MAX_TRAINING_WINDOWS=20000
ML_TRAINING_DAYS=30
ML_CONTAMINATION=0.02
ML_ALERT_SCORE=90
ML_MAX_VALIDATION_ALERT_FRACTION=0.10
ALERT_DEDUPE_SECONDS=900
COLLECTOR_OFFLINE_SECONDS=45

# Optional location settings
MAXMIND_DB_PATH=
# TARGET_LATITUDE=23.8103
# TARGET_LONGITUDE=90.4125
